# MySQL Database Configuration (Using Railway Database)
# Copy these values from Railway → Your Project → Variables
# Then paste them here in .env

# Get these from Railway → Variables:
MYSQL_HOST=your_railway_host_here
MYSQL_USER=your_railway_user_here
MYSQL_PASSWORD=your_railway_password_here
MYSQL_DATABASE=your_railway_database_here
MYSQL_PORT=your_railway_port_here

# Server Port (optional - defaults to 8080)
PORT=8080

# Node Environment
NODE_ENV=development

# JWT Secret for authentication
JWT_SECRET=your-secret-key-change-in-production

# Base URL for QR codes and reset-password link
BASE_URL=https://memoriesman.netlify.app

# Forgot password – שליחת אימייל לאיפוס סיסמה (אופציונלי)
# הוסף ב-Railway → Variables (או כאן ב-.env מקומי)
# אפשרות 1 – SendGrid: SENDGRID_API_KEY + RESET_EMAIL_FROM (כתובת מאומתת ב-SendGrid)
# SENDGRID_API_KEY=SG.xxxx
# RESET_EMAIL_FROM=noreply@yourdomain.com
# אפשרות 2 – SMTP (Gmail): SMTP_USER, SMTP_PASS, RESET_EMAIL_FROM
# SMTP_USER=your@gmail.com
# SMTP_PASS=your-app-password
# RESET_EMAIL_FROM=noreply@yoursite.com

# אחסון קבוע – תמונות/וידאו/אודיו/QR לא יימחקו ב-deploy
# ב-Railway: Add Volume → Mount Path: /app/data → הוסף משתנה:
# STORAGE_PATH=/app/data
